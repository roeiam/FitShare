<?xml version="1.0" encoding="utf-8"?>
<!--
    Heebo - body and UI. Built for Hebrew, holds up at small sizes (SPEC section 7).
    Two weights so android:textStyle="bold" picks Medium instead of synthesising a fake bold.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/heebo_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/heebo_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/heebo_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/heebo_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

</font-family>
