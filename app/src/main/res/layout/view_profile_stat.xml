<?xml version="1.0" encoding="utf-8"?>
<!--
    One of the three profile statistics: a number above a Hebrew label.

    Written once and <include>d three times rather than copied, because three near-identical blocks
    in fragment_profile.xml is exactly the duplication the rubric penalises. Each include carries its
    own id, so ViewBinding hands the Fragment three separate bindings over this same layout.

    No text is set here - the Fragment fills both, since the value is a number and the label differs
    per copy.

    There is deliberately no horizontal padding here. The space between two statistics belongs to
    the divider between them - one dimension, profile_stat_gap - so that padding here would silently
    add to it and make that number mean less than it says.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/statValue"
        style="@style/TextAppearance.FitShare.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="12" />

    <TextView
        android:id="@+id/statLabel"
        style="@style/TextAppearance.FitShare.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="אימונים" />

</LinearLayout>
