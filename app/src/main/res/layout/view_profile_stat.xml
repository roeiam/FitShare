<?xml version="1.0" encoding="utf-8"?>
<!--
    One of the three profile statistics: a number above a Hebrew label.

    Written once and <include>d three times rather than copied, because three near-identical blocks
    in fragment_profile.xml is exactly the duplication the rubric penalises. Each include carries its
    own id, so ViewBinding hands the Fragment three separate bindings over this same layout.

    No text is set here - the Fragment fills both, since the value is a number and the label differs
    per copy.

    The horizontal padding is half the gap between two neighbouring statistics: two adjacent copies
    contribute space_sm each, so they sit space_lg apart inside the centred cluster.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_sm"
    android:paddingEnd="@dimen/space_sm">

    <TextView
        android:id="@+id/statValue"
        style="@style/TextAppearance.FitShare.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="12" />

    <TextView
        android:id="@+id/statLabel"
        style="@style/TextAppearance.FitShare.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="אימונים" />

</LinearLayout>
