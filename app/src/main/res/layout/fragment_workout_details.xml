<?xml version="1.0" encoding="utf-8"?>
<!--
    A workout in full (SPEC section 5): hero image, title, tappable author row, meta chips,
    description and the comment thread.

    The two actions - like and save - live on the author row rather than on a row of their own. One
    line carries who posted it and what you can do about it, which is a row less to scroll past
    before reaching the comments.

    The comment input is pinned outside the scrolling area, so it stays reachable while the thread
    scrolls - and, with the shared keyboard handling, sits directly above the keyboard while typing.

    The four states wrap everything: the content column, plus the three shared state layouts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== Top bar: back + owner actions ===== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_share"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details_edit"
            android:src="@drawable/ic_edit"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details_delete"
            android:src="@drawable/ic_delete"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:paddingBottom="@dimen/space_lg">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hero_image_height"
                    android:contentDescription="@string/cd_workout_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_workout"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FitShare.Card" />

                <TextView
                    android:id="@+id/workoutTitle"
                    style="@style/TextAppearance.FitShare.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="אימון כוח לפלג גוף עליון" />

                <!--
                    ===== Author row =====

                    One line: who posted it, and the two things you can do about it. Reading order
                    under Hebrew RTL is avatar, name and time, then the like mark and the bookmark
                    pinned together against the far end of the row.

                    Only the identity block is clickable, not the whole line, so the ripple stops
                    where the profile link stops and cannot sweep under the two buttons. It carries
                    the weight, so a long Hebrew name is what gives way - the buttons keep their
                    measured width and the name ellipsizes into whatever is left.
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!--
                        Tappable: opens that user's profile, read-only.

                        A ConstraintLayout rather than nested LinearLayouts, and the same avatar +
                        name + time arrangement item_workout.xml already uses. Two levels of
                        LinearLayout weight - one here, one around the text - would make this row the
                        only place in the project measured twice on every layout pass, which is what
                        lint's NestedWeights check is for.
                    -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/authorIdentity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="@dimen/touch_target_min">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/authorAvatar"
                            android:layout_width="@dimen/avatar_size_small"
                            android:layout_height="@dimen/avatar_size_small"
                            android:contentDescription="@string/cd_avatar"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder_avatar"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearance="@style/ShapeAppearance.FitShare.Avatar" />

                        <TextView
                            android:id="@+id/authorName"
                            style="@style/TextAppearance.FitShare.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:ellipsize="end"
                            android:maxLines="1"
                            app:layout_constraintBottom_toTopOf="@id/createdAt"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/authorAvatar"
                            app:layout_constraintTop_toTopOf="@id/authorAvatar"
                            app:layout_constraintVertical_chainStyle="packed"
                            tools:text="רועי עמור" />

                        <TextView
                            android:id="@+id/createdAt"
                            style="@style/TextAppearance.FitShare.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:ellipsize="end"
                            android:maxLines="1"
                            app:layout_constraintBottom_toBottomOf="@id/authorAvatar"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/authorAvatar"
                            app:layout_constraintTop_toBottomOf="@id/authorName"
                            tools:text="לפני 3 שעות" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!--
                        The two actions. Liking is a public reaction and saving is private
                        housekeeping, so they stay visibly distinct - the heart-and-dumbbell mark
                        and a bookmark - but they sit together, because they are the pair of things
                        this screen lets you do.

                        LikeButton sets its own 48dp minimum height in code; the bookmark gets its
                        48dp from touch_target_min here.
                    -->
                    <com.roeiamor.fitshare.ui.common.LikeButton
                        android:id="@+id/likeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm" />

                    <ImageButton
                        android:id="@+id/favoriteButton"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="@dimen/space_xs"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_favorite"
                        android:src="@drawable/ic_bookmark_border" />

                </LinearLayout>

                <!-- Shared with the feed card, see view_meta_chips.xml -->
                <include
                    android:id="@+id/metaChips"
                    layout="@layout/view_meta_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md" />

                <TextView
                    android:id="@+id/workoutDescription"
                    style="@style/TextAppearance.FitShare.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="תיאור האימון" />

                <!-- ===== Comments ===== -->

                <TextView
                    style="@style/TextAppearance.FitShare.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/details_comments" />

                <TextView
                    android:id="@+id/noComments"
                    style="@style/TextAppearance.FitShare.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/details_no_comments"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_comment" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/stateLoading"
            layout="@layout/layout_state_loading" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/layout_state_empty" />

        <include
            android:id="@+id/stateError"
            layout="@layout/layout_state_error" />

    </FrameLayout>

    <!-- ===== Comment input, pinned below the scrolling area ===== -->

    <LinearLayout
        android:id="@+id/commentInputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/commentLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/details_comment_hint">

            <!--
                No IME action. It used to declare actionSend, which promised a send key that never
                arrived - the field is multi-line, so the IME shows Enter for a newline instead - and
                which would have been wrong anyway: posting a comment needs the שליחה button.
                FormKeyboardSupport gives every multi-line field a "done" end icon, so the keyboard
                can still be dismissed from here.
            -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/commentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendComment"
            style="@style/Widget.FitShare.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/details_comment_send" />

    </LinearLayout>

</LinearLayout>
