<?xml version="1.0" encoding="utf-8"?>
<!--
    A workout in full (SPEC section 5): hero image, title, tappable author row, meta chips,
    description, the actions, and the comment thread.

    The comment input is pinned outside the scrolling area, so it stays reachable while the thread
    scrolls - and, with the shared keyboard handling, sits directly above the keyboard while typing.

    The four states wrap everything: the content column, plus the three shared state layouts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== Top bar: back + owner actions ===== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/shareButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_share"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details_edit"
            android:src="@drawable/ic_edit"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/details_delete"
            android:src="@drawable/ic_delete"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:paddingBottom="@dimen/space_lg">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hero_image_height"
                    android:contentDescription="@string/cd_workout_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_workout"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FitShare.Card" />

                <TextView
                    android:id="@+id/workoutTitle"
                    style="@style/TextAppearance.FitShare.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="אימון כוח לפלג גוף עליון" />

                <!-- Tappable author row: opens that user's profile, read-only -->
                <LinearLayout
                    android:id="@+id/authorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/authorAvatar"
                        android:layout_width="@dimen/avatar_size_small"
                        android:layout_height="@dimen/avatar_size_small"
                        android:contentDescription="@string/cd_avatar"
                        android:scaleType="centerCrop"
                        android:src="@drawable/placeholder_avatar"
                        app:shapeAppearance="@style/ShapeAppearance.FitShare.Avatar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/authorName"
                            style="@style/TextAppearance.FitShare.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="רועי עמור" />

                        <TextView
                            android:id="@+id/createdAt"
                            style="@style/TextAppearance.FitShare.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="לפני 3 שעות" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/metaChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:chipSpacingHorizontal="@dimen/space_xs"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/categoryChip"
                        style="@style/Widget.FitShare.Chip.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="כוח" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/durationChip"
                        style="@style/Widget.FitShare.Chip.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="45 דקות" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/difficultyChip"
                        style="@style/Widget.FitShare.Chip.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="בינוני" />

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/workoutDescription"
                    style="@style/TextAppearance.FitShare.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="תיאור האימון" />

                <!-- ===== Actions ===== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.roeiamor.fitshare.ui.common.LikeButton
                        android:id="@+id/likeButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageButton
                        android:id="@+id/favoriteButton"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="@dimen/space_lg"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_favorite"
                        android:src="@drawable/ic_favorites" />

                </LinearLayout>

                <!-- ===== Comments ===== -->

                <TextView
                    style="@style/TextAppearance.FitShare.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/details_comments" />

                <TextView
                    android:id="@+id/noComments"
                    style="@style/TextAppearance.FitShare.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/details_no_comments"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_comment" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/stateLoading"
            layout="@layout/layout_state_loading" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/layout_state_empty" />

        <include
            android:id="@+id/stateError"
            layout="@layout/layout_state_error" />

    </FrameLayout>

    <!-- ===== Comment input, pinned below the scrolling area ===== -->

    <LinearLayout
        android:id="@+id/commentInputRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/commentLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/details_comment_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/commentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendComment"
            style="@style/Widget.FitShare.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/details_comment_send" />

    </LinearLayout>

</LinearLayout>
