<?xml version="1.0" encoding="utf-8"?>
<!-- Login. Phase 3 adds the email and password fields above the buttons; the buttons themselves are final. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_xxl"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            style="@style/TextAppearance.FitShare.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textAlignment="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/login_submit"
            app:shapeAppearance="@style/ShapeAppearance.FitShare.Button" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToRegister"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/login_to_register" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/goToForgotPassword"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/login_forgot" />
    </LinearLayout>

</ScrollView>
