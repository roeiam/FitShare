<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile - serves both my own profile and another user's, chosen by the nullable userId
    argument (SPEC section 5). The edit, theme and logout controls exist only on my own.

    The four states from SPEC section 5 live here: the content container plus the three shared
    state layouts, included rather than copied. ui/common/StateRenderer decides which one shows.
    The FrameLayout is the root, because the four states are stacked rather than sequenced and
    nothing needs to sit above or below them.

    The header is fixed and only the grid scrolls. There is deliberately no ScrollView: nesting a
    RecyclerView inside one defeats view recycling, because the RecyclerView is then measured
    unbounded and lays out every cell at once - which is the standard way to make a list janky.

    RTL: Start/End throughout; the three statistics read right to left on their own.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ===== Header ===== -->

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar"
                android:layout_width="@dimen/avatar_size_large"
                android:layout_height="@dimen/avatar_size_large"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:contentDescription="@string/cd_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_avatar"
                app:shapeAppearance="@style/ShapeAppearance.FitShare.Avatar" />

            <TextView
                android:id="@+id/displayName"
                style="@style/TextAppearance.FitShare.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:textAlignment="center" />

            <!-- Gone when the user has not written one, so the layout does not keep an empty gap -->
            <TextView
                android:id="@+id/bio"
                style="@style/TextAppearance.FitShare.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:maxHeight="@dimen/profile_bio_max_height"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:scrollbars="vertical"
                android:textAlignment="center" />

            <!-- ===== The three statistics (SPEC section 5) =====

                 A centred cluster, not a distribution across the width. The children stay
                 wrap_content so the row is only as wide as its contents and centring keeps that
                 block in the middle of the screen. The statistics themselves have no horizontal
                 padding: the whole distance between two of them is profile_stat_gap, which is the
                 width of the divider View sitting between them, so that one dimension is the only
                 thing to change when this needs loosening or tightening.

                 Weights were tried and rejected: dividing the full width put each number alone in
                 the middle of a 360dp slot, which read as three unrelated items rather than one
                 group of three.

                 The hairline between them is what makes the grouping explicit. The second one is
                 tied to the favourites statistic and is hidden with it on somebody else's profile
                 (see ProfileFragment.bindFavoritesStat) - left behind, it would be a divider with
                 nothing on its far side, which is exactly the "something is missing" reading the
                 hiding was meant to avoid. -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:orientation="horizontal">

                <include
                    android:id="@+id/statWorkouts"
                    layout="@layout/view_profile_stat" />

                <View
                    android:layout_width="@dimen/profile_stat_gap"
                    android:layout_height="@dimen/profile_stat_divider_height"
                    android:background="@drawable/divider_stat" />

                <include
                    android:id="@+id/statLikes"
                    layout="@layout/view_profile_stat" />

                <View
                    android:id="@+id/dividerLikesFavorites"
                    android:layout_width="@dimen/profile_stat_gap"
                    android:layout_height="@dimen/profile_stat_divider_height"
                    android:background="@drawable/divider_stat" />

                <include
                    android:id="@+id/statFavorites"
                    layout="@layout/view_profile_stat" />

            </LinearLayout>

            <!-- ===== Own-profile controls ===== -->

            <LinearLayout
                android:id="@+id/ownerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfile"
                    style="@style/Widget.FitShare.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/profile_edit" />

                <!--
                    The theme toggle. A switch rather than a button because it shows the current
                    state as well as changing it, and the user needs to know which theme they are in.
                -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/themeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md"
                    android:text="@string/profile_theme" />

            </LinearLayout>

            <!-- ===== The workout grid ===== -->

            <!--
                A heading, so the grid reads as a section of the profile rather than a set of
                thumbnails floating under the statistics. Same style as the "תגובות" heading on the
                details screen. Its text depends on whose profile this is - "my workouts" on
                somebody else's would be wrong - and ProfileFragment sets it.
            -->
            <TextView
                android:id="@+id/workoutsHeading"
                style="@style/TextAppearance.FitShare.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal" />

            <!--
                Shown instead of the grid when this user has published nothing. Not the screen's
                empty state: the profile itself loaded fine and still has a name, a bio and an
                avatar worth showing.
            -->
            <!--
                It carries the weight when it is showing, exactly as the grid does when it is not.
                Without that, a profile with no workouts would collapse this to one line and logout
                would ride up under it instead of staying at the bottom of the screen.
            -->
            <TextView
                android:id="@+id/noWorkouts"
                style="@style/TextAppearance.FitShare.Body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/screen_padding_horizontal"
                android:paddingEnd="@dimen/screen_padding_horizontal"
                android:textAlignment="center"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/workoutGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_md"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_md"
                tools:itemCount="6"
                tools:listitem="@layout/item_workout_grid" />

            <!--
                Logout lives at the very bottom, below the grid, and outside the group above.

                It used to sit with edit and the theme switch, which put "sign out" between the user
                and their own workouts - the one destructive control on the screen, in the middle of
                it. At the bottom it is where a destructive action is expected, and reaching it is a
                deliberate scroll to the end rather than something the thumb passes over.

                It has its own visibility because it is no longer inside ownerActions, and it must
                still be absent from somebody else's profile.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logout"
                style="@style/Widget.FitShare.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginEnd="@dimen/screen_padding_horizontal"
                android:layout_marginBottom="@dimen/space_sm"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/profile_logout"
                android:textColor="?attr/colorError" />

        </LinearLayout>

        <include
            android:id="@+id/stateLoading"
            layout="@layout/layout_state_loading" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/layout_state_empty" />

        <include
            android:id="@+id/stateError"
            layout="@layout/layout_state_error" />

</FrameLayout>
