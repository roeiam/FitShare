<?xml version="1.0" encoding="utf-8"?>
<!--
    Where the workout photo comes from (SPEC section 5): camera or gallery.

    RTL: the icons sit at the start - the right under Hebrew - and the labels follow, which is what
    drawableStart gives without any mirroring work.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/space_lg"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/space_xl">

    <TextView
        style="@style/TextAppearance.FitShare.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_photo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fromCamera"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/add_from_camera"
        android:textColor="?attr/colorOnSurface"
        app:icon="@drawable/ic_camera"
        app:iconGravity="start"
        app:iconPadding="@dimen/space_md" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fromGallery"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/add_from_gallery"
        android:textColor="?attr/colorOnSurface"
        app:icon="@drawable/ic_gallery"
        app:iconGravity="start"
        app:iconPadding="@dimen/space_md" />

</LinearLayout>
