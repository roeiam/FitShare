<?xml version="1.0" encoding="utf-8"?>
<!--
    The only Activity layout in the app: a navigation host filling the screen with the bottom
    navigation bar pinned underneath it (SPEC section 5).

    app:navGraph is deliberately absent. MainActivity inflates the graph in code so it can choose
    the start destination from the current session; setting it here as well would inflate the graph
    twice and briefly show the wrong screen at launch.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity">

    <!--
        The no-connection banner (SPEC section 6).

        It lives on the Activity rather than on each screen: connectivity is a property of the
        device, not of whichever fragment happens to be showing, so putting it here means every
        screen gets it and a new screen cannot forget it.

        Gone by default. A gone view in ConstraintLayout collapses to a point, so the nav host sits
        at the top of the screen whenever the banner is hidden.
    -->
    <TextView
        android:id="@+id/offlineBanner"
        style="@style/TextAppearance.FitShare.Label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/danger"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/error_no_network"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/offlineBanner" />

    <!--
        labelVisibilityMode="labeled" is deliberate. With four items the default mode labels only
        the selected tab, which leaves three unlabelled icons - SPEC section 5 names all four.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
