<?xml version="1.0" encoding="utf-8"?>
<!--
    Edit profile: name, bio and avatar.

    The avatar is a tappable circle rather than a separate "choose photo" button - the image is the
    control, which is the pattern every social app uses and needs no label.

    The name field keeps the locale's direction because it is Hebrew text (SPEC section 9.6). The bio
    is multi-line, so FormKeyboardSupport gives it a "done" end icon automatically - see
    ui/common/FormKeyboardSupport.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            style="@style/TextAppearance.FitShare.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_profile_title"
            android:textAlignment="center" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/avatar_size_large"
            android:layout_height="@dimen/avatar_size_large"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:clickable="true"
            android:contentDescription="@string/cd_avatar"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_avatar"
            app:shapeAppearance="@style/ShapeAppearance.FitShare.Avatar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/changeAvatar"
            style="@style/Widget.FitShare.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/edit_profile_avatar" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/edit_profile_name"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textPersonName"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/bioLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/edit_profile_bio">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bioInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/edit_profile_save"
            app:shapeAppearance="@style/ShapeAppearance.FitShare.Button" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/saveProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
