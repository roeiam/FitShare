<?xml version="1.0" encoding="utf-8"?>
<!--
    One saved workout on the Favorites screen.

    A wide row rather than a grid cell, because a favourite is something the user is coming back to
    read: the title gets the width, and the author and category are worth showing.

    Everything here comes from the denormalized snapshot in users/{uid}/favorites, so drawing this
    row costs no extra Firestore read (SPEC section 3).

    Long press removes it - the fragment attaches that listener, so nothing about it is in this file.

    RTL: Start/End throughout, so the thumbnail sits on the right under Hebrew.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favoriteCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="@dimen/elevation_card"
    app:shapeAppearance="@style/ShapeAppearance.FitShare.Card"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/favoriteImage"
            android:layout_width="@dimen/favorite_thumb_size"
            android:layout_height="@dimen/favorite_thumb_size"
            android:contentDescription="@string/cd_workout_image"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_workout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FitShare.Card" />

        <!--
            The text chain hangs off the parent, not off the thumbnail, and that is deliberate.

            A favourite with no photo hides favoriteImage, and a GONE widget in ConstraintLayout
            collapses to a point - so a title anchored to its top and bottom would have been packed
            into a zero-height span, and the row, which is wrap_content, would have had nothing left
            to give it height. Anchored to the parent instead, the text stands on its own and the row
            is as tall as whatever is actually in it.

            layout_goneMarginStart pulls the text back to the card's padding when the thumbnail is
            gone; without it the row would keep a 72dp-wide hole where the photo used to be, which is
            the whole defect this change exists to remove.
        -->
        <TextView
            android:id="@+id/favoriteTitle"
            style="@style/TextAppearance.FitShare.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintBottom_toTopOf="@id/favoriteAuthor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/favoriteImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginStart="0dp"
            tools:text="אימון כוח לפלג גוף עליון" />

        <TextView
            android:id="@+id/favoriteAuthor"
            style="@style/TextAppearance.FitShare.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/favoriteImage"
            app:layout_constraintTop_toBottomOf="@id/favoriteTitle"
            app:layout_goneMarginStart="0dp"
            tools:text="רועי אמור · כוח" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
