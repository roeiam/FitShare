    <!--
        Relative time (util/TimeFormatter). Plurals, not plain format strings: Hebrew inflects for
        one and for two, so "לפני %d דקות" would render "לפני 1 דקות" and read as broken Hebrew.
    -->
    <string name="time_now">כרגע</string>
    <string name="time_yesterday">אתמול</string>

