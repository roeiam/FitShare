<?xml version="1.0" encoding="utf-8"?>
<!--
    The five text styles from SPEC section 7, defined once.

    IMPORTANT - apply these with style="@style/TextAppearance.FitShare.Body", NOT with
    android:textAppearance="...". Applied as a full style, android:lineSpacingMultiplier
    takes effect; referenced as a textAppearance it would be silently ignored, and Hebrew
    needs the 1.3 line spacing to stay readable.

    Colours are intentionally absent - they come from the theme, so the same style works
    in light and dark.
-->
<resources>

    <style name="TextAppearance.FitShare" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="TextAppearance.FitShare.Headline">
        <item name="android:fontFamily">@font/font_heading</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="TextAppearance.FitShare.Title">
        <item name="android:fontFamily">@font/font_heading</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="TextAppearance.FitShare.Body">
        <item name="android:fontFamily">@font/font_body</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="TextAppearance.FitShare.Label">
        <item name="android:fontFamily">@font/font_body</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.FitShare.Caption">
        <item name="android:fontFamily">@font/font_body</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!--
        Text buttons and links. Defined once so no layout ever names a colour.

        The text colour comes from @color/link_text, which has a values-night variant - the resource
        qualifier does the theming, so no custom theme attribute is needed. Material3's default text
        colour here would be colorPrimary, which fails the contrast rule in the light theme.
    -->
    <style name="Widget.FitShare.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/link_text</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!--
        The meta chips on a workout card: category, duration, difficulty.
        Display only - they show information, they are not controls, so they are not clickable and
        not checkable. Without that they would take touch feedback and read as tappable.
    -->
    <style name="Widget.FitShare.Chip.Meta" parent="Widget.Material3.Chip.Assist">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:checkable">false</item>
        <item name="chipMinHeight">28dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textAppearance">@style/TextAppearance.FitShare.Caption</item>
    </style>

    <!-- The category filter chips on the feed. These *are* controls. -->
    <style name="Widget.FitShare.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.FitShare.Label</item>
    </style>

    <!-- Circular avatar, used on cards and later on the profile -->
    <style name="ShapeAppearance.FitShare.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Shape appearances, so every card / button / image rounds identically -->
    <style name="ShapeAppearance.FitShare.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.FitShare.Button" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_button</item>
    </style>

</resources>
