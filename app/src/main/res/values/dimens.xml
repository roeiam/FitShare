<?xml version="1.0" encoding="utf-8"?>
<!--
    Every dp value in the project comes from here. A layout that hardcodes "12dp"
    is a defect - SPEC section 7 makes the spacing scale explicit.
-->
<resources>

    <!-- Spacing scale (SPEC section 7): 4 / 8 / 12 / 16 / 24 / 32 -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>

    <!-- Screen and list metrics -->
    <dimen name="screen_padding_horizontal">16dp</dimen>
    <dimen name="card_gap">12dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_card">16dp</dimen>
    <dimen name="radius_button">12dp</dimen>
    <dimen name="radius_image">16dp</dimen>

    <!-- Component sizes -->
    <dimen name="avatar_size_small">40dp</dimen>
    <dimen name="avatar_size_large">96dp</dimen>
    <!--
        The brand mark above the auth forms. The source is the launcher icon's own artwork, whose
        usable square is 259px, so anything above 64dp is drawn from an upscale on an xxxhdpi
        screen (96dp needs 384px there) and softens slightly. Below xxxhdpi it still downscales.
    -->
    <dimen name="logo_size">96dp</dimen>
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="icon_size">24dp</dimen>
    <dimen name="state_icon_size">72dp</dimen>
    <dimen name="image_picker_height">200dp</dimen>
    <dimen name="like_mark_size">28dp</dimen>
    <!-- Reserves room for a two-digit count, so the mark does not shift as the number changes -->
    <dimen name="like_count_min_width">24dp</dimen>
    <dimen name="hero_image_height">240dp</dimen>
    <dimen name="comment_avatar_size">32dp</dimen>
    <dimen name="favorite_thumb_size">72dp</dimen>
    <dimen name="elevation_card">0dp</dimen>

    <!-- Profile: the workout grid and the three-statistic row -->
    <dimen name="grid_item_gap">8dp</dimen>
    <dimen name="profile_bio_max_height">96dp</dimen>
    <!-- The one number that tunes how far apart the profile statistics sit. It is the full
         stat-to-stat distance: the divider View is exactly this wide and the hairline is drawn
         centred inside it (see drawable/divider_stat.xml), so nothing else contributes and this
         can be changed on its own without touching the shared spacing scale. -->
    <dimen name="profile_stat_gap">32dp</dimen>
    <!-- A hairline, and deliberately shorter than the statistic beside it so it reads as a
         separator inside a group rather than as a rule across the screen. -->
    <dimen name="profile_stat_divider_width">1dp</dimen>
    <dimen name="profile_stat_divider_height">32dp</dimen>

    <!-- Text sizes (SPEC section 7) -->
    <dimen name="text_headline">22sp</dimen>
    <dimen name="text_title">18sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_label">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>

</resources>
