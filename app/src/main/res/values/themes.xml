<?xml version="1.0" encoding="utf-8"?>
<!--
    Light theme. The dark counterpart lives in values-night/themes.xml and overrides only
    the colour roles - everything structural is defined once, here.

    colorOnPrimary is @color/ink rather than white on purpose: ink on mint_on_light measures
    5.4:1, white on mint_on_light only 3.4:1, and SPEC section 7 requires 4.5:1.
-->
<resources>

    <style name="Base.Theme.FitShare" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/mint_on_light</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/mint_on_light</item>
        <item name="colorOnSecondary">@color/ink</item>
        <!-- Drives the bottom navigation's active pill -->
        <item name="colorSecondaryContainer">@color/mint</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/cloud</item>

        <!--
            The window's own background, behind everything the Activity draws.

            Set explicitly, and this is not cosmetic. Switching the theme calls
            setDefaultNightMode, which recreates the Activity, and for the moment between the old
            window going away and the new one drawing, the only thing on screen is this. Left
            unset it inherits the platform default, which is black - so flipping the theme flashed
            a full black screen. Pointing it at the app's own background makes that frame the
            colour the app is about to be anyway, in whichever theme is being switched to.
        -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="colorOnBackground">@color/text_on_light_high</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_on_light_high</item>
        <item name="colorSurfaceVariant">@color/cloud</item>
        <item name="colorOnSurfaceVariant">@color/text_on_light_muted</item>
        <!-- Bottom navigation background -->
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_light</item>

        <!-- Errors -->
        <item name="colorError">@color/danger_on_light</item>
        <item name="colorOnError">@color/white</item>

        <!-- Typography default, so even an unstyled TextView renders in Heebo -->
        <item name="android:fontFamily">@font/font_body</item>
        <item name="fontFamily">@font/font_body</item>

        <!-- Shape -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.FitShare.Card</item>
    </style>

    <style name="Theme.FitShare" parent="Base.Theme.FitShare" />

</resources>
