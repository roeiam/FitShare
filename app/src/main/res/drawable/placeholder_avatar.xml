<?xml version="1.0" encoding="utf-8"?>
<!--
    Shown while an avatar loads, and permanently for a user who has no photo.

    A filled circle with a head-and-shoulders silhouette on it, rather than the bare circle this
    used to be: an empty circle reads as an image that failed, while a silhouette reads as "no
    photo set", which is what it actually means.

    The silhouette carries its own margin inside its viewport, so this file applies no inset - see
    ic_avatar_silhouette.xml. That keeps one placeholder correct at all three sizes it is used at.

    Both colours carry values-night overrides, so the silhouette stays visible in either theme. That
    matters here: an earlier version of the placeholder resolved to the same colour as the page and
    was invisible in light theme, which is exactly the trap this file has to avoid.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/placeholder_fill" />
        </shape>
    </item>

    <item android:drawable="@drawable/ic_avatar_silhouette" />

</layer-list>
