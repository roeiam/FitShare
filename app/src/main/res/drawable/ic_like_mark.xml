<?xml version="1.0" encoding="utf-8"?>
<!--
    The signature mark from SPEC section 7: the logo's heart-and-dumbbell.

    One path, not two. The heart and the dumbbell are subpaths of a single path with
    android:fillType="evenOdd", so the dumbbell is *knocked out* of the heart rather than painted on
    top of it. That keeps the whole mark a single colour, which is what makes it work in both
    themes and in both states - the view simply tints it: muted when the workout is not liked, mint
    when it is. Two overlapping paths would have needed the inner one to match the card surface,
    and would have broken the moment the surface colour changed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
