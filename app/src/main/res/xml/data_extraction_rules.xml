<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for API 31 and above. Referenced from the Manifest's
    android:dataExtractionRules.

    Both sections are deliberately empty, for the same reason as backup_rules.xml: the only local
    state is the theme flag in SharedPreferences, and everything that matters is in Firebase. No
    credentials are stored on the device - Firebase Auth keeps its own token store, which is excluded
    from backup by the SDK itself.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
