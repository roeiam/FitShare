<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 30 and below. Referenced from the Manifest's android:fullBackupContent.

    Nothing is included or excluded, on purpose. The only thing FitShare stores on the device is the
    theme choice in SharedPreferences (util/ThemePreferences.kt); everything else - the account, the
    workouts, the comments, the favourites - lives in Firebase and comes back on the next sign-in.
    Backing up the theme flag is harmless, and an empty ruleset is what asks for the default
    behaviour rather than an accidental one.
-->
<full-backup-content />
